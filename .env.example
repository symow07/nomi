# Nomi v1.0 — TypeScript service environment (copy to .env, fill, never commit)
# The n8n-era variables live in docs/env-checklist.md; this file is the service's.

# ── Database: ANY standard PostgreSQL (Railway, Neon, RDS, self-hosted) ──────
# Runtime role: nomi_app (RLS-enforced, no BYPASSRLS, not superuser).
DATABASE_URL=postgresql://nomi_app:CHANGE_ME@host:5432/nomi
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=30000
# Admin/DDL credentials for `node tools/migrate.mjs` ONLY — keep separate from
# the runtime role above. Never used by the running service.
MIGRATE_DATABASE_URL=postgresql://postgres:CHANGE_ME@host:5432/nomi

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ── WhatsApp provider: 'meta' | '360dialog' | 'disabled' ────────────────────
# Only the selected provider's variables are required. 'disabled' (or unset) =
# deployment mode: the service boots with database + workers + /health but no
# messaging surface — for hosting before provider onboarding completes.
# DATABASE_URL and ANTHROPIC_API_KEY are required in ALL modes.
WHATSAPP_PROVIDER=meta

# Meta WhatsApp Cloud API (see docs/META-CLOUD-API-SETUP.md)
META_WHATSAPP_ACCESS_TOKEN=CHANGE_ME
META_WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME
META_WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
META_GRAPH_API_VERSION=v23.0

# 360dialog (kept for production BSP migration later; unused when provider=meta)
#D360_API_KEY=
#D360_BASE_URL=https://waba-sandbox.360dialog.io
#WEBHOOK_SECRET=            # 360dialog webhook HMAC secret (32+ chars)

# ── Hearing voice notes (speech-to-text) ────────────────────────────────────
# Optional. Unset, she refuses every voice note and tells the owner she could
# not hear it. Voice notes and photos are DOWNLOADED with the provider
# credential above; this is only the transcriber (Whisper or compatible).
#TRANSCRIBE_API_KEY=
#TRANSCRIBE_BASE_URL=https://api.openai.com/v1

# ── Sending mail as her own domain (M40) ────────────────────────────────────
# Both optional, and both arrive with the sending provider (M52).
# SENDING_SPF_INCLUDE is the provider's own SPF mechanism. Until it is set, her
# SPF record can be read but not CONFIRMED, and the page says exactly that
# rather than telling her a correct record is wrong.
# EMAIL_WEBHOOK_SECRET is the shared secret the provider signs its callbacks
# with: bounce and complaint events (/hooks/email) and buyers' replies
# (/hooks/email/inbound). Unset, neither is mounted: an unverified endpoint that
# writes permanent suppressions is a way for anyone to remove her buyers one
# address at a time.
#SENDING_SPF_INCLUDE=mail.provider.example
#EMAIL_WEBHOOK_SECRET=

# ── Her sending mailbox (C6) ─────────────────────────────────────────────────
# The installation's own OAuth apps, for "Connect Gmail" / "Connect Outlook" on
# the channels page. Each pair is both-or-neither; a half pair is not configured
# and says so at boot. Both need PUBLIC_BASE_URL, which the provider redirects
# back to. Until one is set and she connects a mailbox, no e-mail leaves: the
# transport refuses and says why rather than pretending to send.
#GOOGLE_OAUTH_CLIENT_ID=
#GOOGLE_OAUTH_CLIENT_SECRET=
#MICROSOFT_OAUTH_CLIENT_ID=
#MICROSOFT_OAUTH_CLIENT_SECRET=
# Only for an Entra app registered for "this organization only": its Directory
# (tenant) ID. Unset asks at /common, which Microsoft refuses for such an app.
# Step-by-step setup for both providers: docs/EMAIL-SETUP.md
#MICROSOFT_OAUTH_TENANT=

# ── The address buyers reach this installation at ───────────────────────────
# Optional, https only. Every quote she sends carries a link to the page that
# shows where the price came from, and that link is built on this. Unset, no
# link is attached to a reply and the owner is told so on the conversation —
# never a path with no host, which is what she used to be shown.
#PUBLIC_BASE_URL=https://nomi.yourdomain.com

# ── Internal application secrets ─────────────────────────────────────────────
# GENERATED AUTOMATICALLY on first start if missing (crypto.randomBytes,
# appended to .env, never overwritten, never logged). No manual action needed.
#WEBHOOK_VERIFY_TOKEN=
#CREDENTIAL_KEY=

# ── Which factory this deployment serves ────────────────────────────────────
# Boot refuses if PILOT_BUSINESS_ID is unset, names a business that does not
# exist, or names the practice sandbox. `tools/provision-factory.mjs` prints it.
PILOT_BUSINESS_ID=CHANGE_ME
# The owner's only credential. Unset, a random one is generated PER BOOT and
# logged once — so it changes on every deploy.
OWNER_ACCESS_CODE=CHANGE_ME

# ── Messaging templates Meta has actually approved ──────────────────────────
# Comma-separated names. Empty (the default) means a conversation older than 24
# hours goes back to the owner instead of being re-opened. Nothing here calls
# Meta to check: an operator records what was granted.
#META_TEMPLATE_NAMES=

# ── The practice sandbox ────────────────────────────────────────────────────
# Defaults to the seeded sandbox tenant, and must never equal PILOT_BUSINESS_ID.
#SANDBOX_BUSINESS_ID=
# `1` offers Live-AI mode in the sandbox. It spends tokens; scripted is default.
#SANDBOX_LIVE_AI=

# ── What the owner calls her ────────────────────────────────────────────────
# Unset, she is 小雅 and the header shows the brand mark. An emoji avatar wins.
#EMPLOYEE_NAME=
#EMPLOYEE_AVATAR=

# ── Service ──────────────────────────────────────────────────────────────────
PORT=8787
ENGINE_VERSION=v1.0
# `production` makes the three boot guards REFUSE rather than warn. Leave unset
# locally: it also flips the session cookie to Secure, which never comes back
# over plain http, so every /app request bounces to /login.
#NODE_ENV=production
