# YiwuFlow v1.0 — TypeScript service environment (copy to .env, fill, never commit)
# The n8n-era variables live in docs/env-checklist.md; this file is the service's.

# ── Database: ANY standard PostgreSQL (Railway, Neon, RDS, self-hosted) ──────
# Runtime role: yiwuflow_app (RLS-enforced, no BYPASSRLS, not superuser).
DATABASE_URL=postgresql://yiwuflow_app:CHANGE_ME@host:5432/yiwuflow
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=30000
# Admin/DDL credentials for `node tools/migrate.mjs` ONLY — keep separate from
# the runtime role above. Never used by the running service.
MIGRATE_DATABASE_URL=postgresql://postgres:CHANGE_ME@host:5432/yiwuflow

# ── LLM ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# ── WhatsApp via 360dialog ───────────────────────────────────────────────────
# Sandbox: https://hub.360dialog.com → free sandbox, key is instant.
D360_API_KEY=CHANGE_ME
D360_BASE_URL=https://waba-sandbox.360dialog.io
# You choose both of these (32+ random chars); WEBHOOK_SECRET is also given
# to the provider webhook config for HMAC signing.
WEBHOOK_SECRET=CHANGE_ME
WEBHOOK_VERIFY_TOKEN=CHANGE_ME

# ── Credential encryption at rest ────────────────────────────────────────────
# Generate: openssl rand -hex 32
CREDENTIAL_KEY=CHANGE_ME

# ── Service ──────────────────────────────────────────────────────────────────
PORT=8787
ENGINE_VERSION=v1.0
